{
  "name": "pizarra",
  "version": "1.24.0",
  "private": true,
  "description": "Pizarra — app de wireframing y bocetos web con estética dibujada a mano",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
